<![CDATA[<div class="container mt-4">
    <h2 class="title mb-4">Mis Compras</h2>

    {{#if tickets.length}}
        <div class="row">
            {{#each tickets}}
                <div class="col-12 mb-4">
                    <div class="card">
                        <div class="card-body">
                            <h5 class="card-title">Compra #{{code}}</h5>
                            <p class="card-text">
                                <strong>Fecha:</strong> {{formatDate purchase_datetime}}<br>
                                <strong>Total:</strong> ${{amount}}
                            </p>
                            
                            <div class="mt-3">
                                <h6>Productos:</h6>
                                <ul class="list-group">
                                    {{#each products}}
                                        <li class="list-group-item d-flex justify-content-between align-items-center">
                                            {{product.title}}
                                            <span class="badge bg-primary rounded-pill">x{{quantity}}</span>
                                        </li>
                                    {{/each}}
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            {{/each}}
        </div>
    {{else}}
        <div class="alert alert-info">
            No tienes compras realizadas aún.
        </div>
    {{/if}}
