<div class="container">
    <div class="card">
        <div class="card-body">
            <h2 class="card-title">Perfil de Usuario</h2>
            <div class="user-info">
                <p><strong>Nombre:</strong> {{user.first_name}}</p>
                <p><strong>Apellido:</strong> {{user.last_name}}</p>
                <p><strong>Email:</strong> {{user.email}}</p>
                <p><strong>Rol:</strong> {{user.role}}</p>
            </div>
        </div>
    </div>
</div>
